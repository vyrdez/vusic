# Android / Gradle
*.iml
.gradle/
/.idea/
.DS_Store
/build/
/app/build/
/baselineprofile/build/
/captures
.externalNativeBuild
.cxx/
.kotlin/

# Local machine configuration (sdk.dir) — never committed.
/local.properties
local.properties

# Build outputs. Release APKs are published as GitHub Release assets,
# never stored in the git tree.
/release/

# Keystore / signing material — never committed, never pushed.
/keystore/
keystore.properties
*.jks
*.keystore
*.p12
*.pfx

# Test config with credentials (never commit live server details)
nd_test.properties

# Screenshots / screen recordings. These are development artifacts and are
# deliberately not part of the public repository. Application resources under
# src/**/res are build inputs, so they stay exempt.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
!**/src/**/res/**

# OS / editor noise
Thumbs.db
*.swp
.idea/
*.log
