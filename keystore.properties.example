# Copy this file to keystore/keystore.properties and fill in your own values.
# The real file is gitignored and must NEVER be committed.
#
# Generate your own keystore with:
#   keytool -genkeypair -v -keystore keystore/vusic-release.jks \
#           -alias vusic -keyalg RSA -keysize 4096 -validity 10950
#
# -validity 10950 is 30 years; Android requires at least 25 for install keys.
#
# Keep the keystore and this file OUTSIDE version control and back them up:
# Android ties app updates to the signing certificate, so losing or replacing
# the keystore means users can never upgrade in place.

storePassword=CHANGE_ME
keyAlias=vusic
keyPassword=CHANGE_ME
