<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local plain-HTTP servers (e.g. http://192.168.x.x:4533) must work;
         public servers should still use HTTPS. System TLS anchors apply. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
