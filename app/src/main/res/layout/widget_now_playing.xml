<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop"
        android:src="@drawable/art_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="-1"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:text="Vusic"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Not playing"
            android:textColor="#9AA0A6"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Previous track"
        android:scaleType="center"
        android:src="@drawable/ic_widget_prev" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play"
        android:scaleType="center"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Next track"
        android:scaleType="center"
        android:src="@drawable/ic_widget_next" />

    <ImageButton
        android:id="@+id/w_fav"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Add to favorites"
        android:scaleType="center"
        android:src="@drawable/ic_widget_fav_off" />
</LinearLayout>
