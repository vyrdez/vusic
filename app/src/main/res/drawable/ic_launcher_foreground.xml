<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!--
      Vusic mark: the same eighth note the app already uses in its UI
      (Material's Icons.Default.MusicNote, the glyph next to "Vusic" on Home).

      White on the black adaptive-icon background, and kept inside the 66dp
      safe zone of the 108dp canvas so no launcher mask (circle, squircle,
      rounded square, teardrop) can clip it. The glyph's own bounds in the 24dp
      viewport are x 6..18, y 3..21 - centred on (12,12) - so a plain
      scale-2.5-about-the-centre places it at 30x45dp dead centre.
    -->
    <group
        android:scaleX="2.5" android:scaleY="2.5"
        android:translateX="24" android:translateY="24">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,3v10.55c-0.59,-0.34 -1.27,-0.55 -2,-0.55 -2.21,0 -4,1.79 -4,4s1.79,4 4,4 4,-1.79 4,-4V7h4V3h-6z" />
    </group>
</vector>
