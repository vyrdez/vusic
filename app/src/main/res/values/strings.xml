<resources>
    <string name="app_name">Vusic</string>
    <string name="widget_desc">Vusic now playing</string>
    <color name="ic_launcher_background">#0B0F14</color>
    <style name="Theme.Feishin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F0F0F</item>
    </style>

    <!-- Android 12+ splash: Vusic mark on the app background, no icon-in-icon. -->
    <style name="Theme.Feishin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F0F0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">#0F0F0F</item>
        <item name="postSplashScreenTheme">@style/Theme.Feishin</item>
    </style>
</resources>
